# Earth Engine project that owns the assets and runs the compute.
EE_PROJECT_ID=earth-engine-484907

# Where the training assets live. Cloud projects use projects/<id>/assets,
# legacy accounts use users/<username>.
EE_ASSET_ROOT=projects/earth-engine-484907/assets

# Exact asset path per class. Rename the right-hand side to whatever each asset
# is really called in the project. These win over EE_ASSET_ROOT, so an asset
# borrowed from another project can be pasted in whole.
# Forest (label 0)
EE_ASSET_FOREST=projects/earth-engine-484907/assets/jabalpur_forest_points
# Water (label 1)
EE_ASSET_WATER=projects/earth-engine-484907/assets/jabalpur_water_points
# Buildings (label 2)
EE_ASSET_BUILDINGS=projects/earth-engine-484907/assets/jabalpur_building_points
# Barren Land (label 3)
EE_ASSET_BARREN=projects/earth-engine-484907/assets/jabalpur_barren_points
# Agriculture (label 4) - must carry a per-feature label attribute, or every
# row is silently dropped at sampling time and the class trains on nothing.
EE_ASSET_AGRICULTURE=projects/earth-engine-484907/assets/jabalpur_agriculture_points_labelled

# Optional: pre-Agriculture baseline table, only read by before/after comparisons.
EE_ASSET_BEFORE_TABLE=projects/earth-engine-484907/assets/district_train_table

# Optional: paste a service-account JSON key here for headless/hosted runs
# instead of `earthengine authenticate`.
# EE_SERVICE_ACCOUNT_KEY=
