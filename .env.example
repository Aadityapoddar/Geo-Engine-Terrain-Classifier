# Earth Engine project. Owns every asset below and runs the compute.
EE_PROJECT_ID=earth-engine-484907

# Required on Render / Hugging Face / any host without `earthengine authenticate`.
# Paste the full service-account JSON as one line. Leave empty for local user auth.
# EE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# The exact asset behind each land cover class. Renaming an asset in the
# project is a one-line edit here.
# Forest (label 0)
EE_ASSET_FOREST=projects/earth-engine-484907/assets/jabalpur_forest_points
# Water (label 1)
EE_ASSET_WATER=projects/earth-engine-484907/assets/jabalpur_water_points
# Buildings (label 2)
EE_ASSET_BUILDINGS=projects/earth-engine-484907/assets/jabalpur_building_points
# Barren Land (label 3)
EE_ASSET_BARREN=projects/earth-engine-484907/assets/jabalpur_barren_points
# Agriculture (label 4)
EE_ASSET_AGRICULTURE=projects/earth-engine-484907/assets/jabalpur_agriculture_points_labelled
